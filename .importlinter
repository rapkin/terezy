; Architecture boundaries from the constitution ("Architecture Constraints").
; These are compliance tests for Principle III (Pure Deterministic Core) and
; Principle II (Framework, Not Script). A violation fails the build.
;
; Run with:  uv run lint-imports

[importlinter]
root_package = terezy
include_external_packages = True

[importlinter:contract:layers]
name = Layered architecture — dependencies point one way only
type = layers
layers =
    terezy.cli
    terezy.api
    terezy.data
    terezy.core

[importlinter:contract:core-is-pure]
name = The core performs no I/O, no network, no rendering, no formatting
type = forbidden
source_modules =
    terezy.core
forbidden_modules =
    ; --- network ---
    http
    httpx
    requests
    socket
    urllib
    urllib3
    ; --- filesystem / process ---
    pathlib
    shutil
    subprocess
    tempfile
    os
    io
    ; --- serialisation & rendering are the API layer's job ---
    csv
    json
    pickle
    sqlite3
    tomllib
    logging
    argparse
    matplotlib
    ; --- nondeterminism: seeds are explicit and recorded in the manifest ---
    random
    secrets
    uuid
    ; --- hashing implies serialisation; the digest lives in terezy.data.manifest ---
    hashlib
    ; --- no class hierarchies: functional style, owner decision D-E ---
    abc
allow_indirect_imports = False

[importlinter:contract:core-independent-of-frameworks]
name = The core knows nothing about its delivery surface
type = forbidden
source_modules =
    terezy.core
forbidden_modules =
    fastapi
    starlette
    uvicorn
    typer
    click
    rich
    ; validation belongs at the data boundary, not in the domain
    pydantic
allow_indirect_imports = False

[importlinter:contract:data-below-api]
name = The data layer never reaches up into orchestration
type = forbidden
source_modules =
    terezy.data
forbidden_modules =
    terezy.api
    terezy.cli

; --- feature 011: the tax-currency role, and the prohibition that guards it -------------
;
; Constitution Principle VI gives currency three roles and says conflating any two is a
; defect. The one this pair of contracts guards is tax-versus-transaction, and it is
; **bidirectional**: an official rate decides what the law says an income was and never how
; much money arrived, and a channel rate decides how much money arrived and never what the
; law says. They are two requirements (011 FR-012 and FR-013), so they are two contracts —
; one naming both source modules would stay green if either direction were deleted, and the
; requirement that survived would look enforced.

[importlinter:contract:official-rate-never-prices-a-leg]
name = FR-012 — the amount received is never computed from an official rate
type = forbidden
source_modules =
    terezy.core.routes
forbidden_modules =
    terezy.core.tax.official_rate
allow_indirect_imports = False

; ⚙ `allow_indirect_imports = True` on the second contract, and only on it: it means DIRECT
; imports only. The chain that forces it is
; `terezy.core.tax.year -> ledger.engine -> routes.capacity -> routes.legs -> routes.channels`
; — four hops that exist for capacity pools and have nothing to do with a rate, and the last
; of which is why forbidding the module indirectly is not available. What this contract forbids is a tax module reaching for the module that
; owns `reference_rate` — and the value-level claim, that no tax figure is derived from one,
; is asserted over the source in tests/contract/test_the_rate_you_are_taxed_at.py.

[importlinter:contract:no-tax-base-from-a-channel]
name = FR-013 — a channel's reference rate never serves as a tax rate
type = forbidden
source_modules =
    terezy.core.tax
forbidden_modules =
    terezy.core.routes.channels
allow_indirect_imports = True

; --- feature 020: the delivery framework lives in exactly one module tree ------------------
;
; `core-independent-of-frameworks` above keeps the framework out of the core. This keeps it out
; of everything else that is not the HTTP surface -- including `terezy.api.answer`, which is
; orchestration the CLI shares and which a below-only contract says nothing about. `pydantic` is
; deliberately absent: the data layer already imports it at the load boundary, which is where the
; constitution says validation belongs.
;
; Two modules this cannot reach -- `src/terezy/__init__.py` and `src/terezy/api/__init__.py` --
; are covered by a source scan, and a completeness check asserts the union reaches every module
; under `src/terezy/`: tests/contract/test_the_framework_stays_in_one_module.py.

[importlinter:contract:frameworks-only-in-the-http-module]
name = FR-002 — fastapi, starlette and uvicorn appear only under terezy.api.http
type = forbidden
source_modules =
    terezy.data
    terezy.cli
    terezy.api.answer
    terezy.api.diagrams
forbidden_modules =
    fastapi
    starlette
    uvicorn
allow_indirect_imports = False
