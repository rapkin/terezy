# The image carries code, never data: `data/` is mounted read-only at runtime (020 FR-033), so
# an image built here holds no part of one person's finances even if it is pushed somewhere.
data
.venv
.git
.github
.claude
.specify
.hypothesis
.mypy_cache
.pytest_cache
.ruff_cache
.import_linter_cache
.coverage
**/__pycache__
docs
specs
scripts
# The OpenAPI generator is the exception: the document is generated on the fly (owner decision
# 2026-09-05) and the client's types come out of it, so the build needs it.
!scripts/generate_openapi.py
tests
